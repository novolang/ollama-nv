// ollapi.nv — the client, and the only module in this package that
// reaches a server.
//
// Every body here is a `todo()`; the signatures are the design.
//
// EVERY CALL HERE IS EFFECT-POLYMORPHIC OVER llm-client-nv's
// `LlmcTransport[e]`, so a call costs exactly what the caller's
// transport costs — `[net]` over TLS through a tunnel, `[io, net,
// time, async]` over the standard library's HTTP client, nothing at
// all over a recorded transcript in a test.  **This package declares
// no transport of its own**, and that is the sibling dependency
// earning its place: two clients that both invented a byte pipe would
// be two pipes a program holding both has to configure separately.
//
// THE ENDPOINT PATHS ARE HERE AND NOWHERE ELSE.  `ollembed.path_of`
// is the one exception, because which of the two embedding endpoints
// to use is a property of the request rather than of the call.
//
// A LOCAL SERVER IS USUALLY PLAINTEXT ON LOOPBACK, which is why
// `local_provider` builds an `LlmcProvider` with an empty key and an
// `http://` origin: this API takes no authentication at all, and a
// client that sent an `Authorization` header would be sending a secret
// to a process that ignores it.  A server behind a tunnel or a reverse
// proxy is the same value with a different origin and whatever headers
// the proxy wants, through `llmcreq.with_header`.

use llmcreq

// An `LlmcProvider` pointed at a local server.
//
// The OpenAI-compatible endpoint on the same server is
// `llmcreq.compatible(base_url, "")`, and a program that wants one
// code path across hosted and local models uses that and never needs
// this package.  This provider is the same origin with the dialect
// field unused, because `/api/*` is neither dialect.
//
// ```novo
// use ollapi
// use llmcreq
//
// fn main() [io]
//     println(llmcreq.provider_base_url(ollapi.local_provider()))
//     // : http://127.0.0.1:11434
// ```
pub fn local_provider() -> LlmcProvider []
    todo("ollama-nv.ollapi.local_provider")

// A provider for a server at another origin.
//
// ```novo
// use ollapi
// use llmcreq
//
// fn main() [io]
//     let p = ollapi.provider_at("http://gpu-box.example:11434")
//     println(llmcreq.provider_base_url(p))
//     // : http://gpu-box.example:11434
// ```
pub fn provider_at(base_url: Str) -> LlmcProvider []
    todo("ollama-nv.ollapi.provider_at")

// One buffered `/api/generate`.
//
// `[e]`: whatever the transport costs.
//
// ```novo ignore
// use ollapi
//
// fn ask(t: LlmcStdHttp, g: OllGenerate) -> Result<OllReply, OllFault> [io, net, time, async]
//     ollapi.generate(t, g)
// ```
pub fn generate<T: LlmcTransport[e]>(t: T, g: OllGenerate) -> Result<OllReply, OllFault> [e]
    todo("ollama-nv.ollapi.generate")

// One buffered `/api/chat`.
//
// ```novo ignore
// use ollapi
//
// fn ask(t: LlmcStdHttp, c: OllChat) -> Result<OllReply, OllFault> [io, net, time, async]
//     ollapi.chat(t, c)
// ```
pub fn chat<T: LlmcTransport[e]>(t: T, c: OllChat) -> Result<OllReply, OllFault> [e]
    todo("ollama-nv.ollapi.chat")

// A streamed reply in progress: the line reader, the accumulator, and
// the bytes read so far.
//
// A VALUE the caller threads through `stream_next`, so the loop is the
// caller's.
pub struct OllStreamState
    reader: OllNdReader
    acc: OllStream
    read_bytes: Int

// Open a streamed `/api/generate` and answer the state to pump.
//
// ```novo ignore
// use ollapi
//
// fn open(t: LlmcStdHttp, g: OllGenerate) -> Result<OllStreamState, OllFault> [io, net, time, async]
//     ollapi.generate_stream(t, g)
// ```
pub fn generate_stream<T: LlmcTransport[e]>(t: T,
                                            g: OllGenerate) -> Result<OllStreamState, OllFault> [e]
    todo("ollama-nv.ollapi.generate_stream")

// Open a streamed `/api/chat` and answer the state to pump.
//
// ```novo ignore
// use ollapi
//
// fn open(t: LlmcStdHttp, c: OllChat) -> Result<OllStreamState, OllFault> [io, net, time, async]
//     ollapi.chat_stream(t, c)
// ```
pub fn chat_stream<T: LlmcTransport[e]>(t: T, c: OllChat) -> Result<OllStreamState, OllFault> [e]
    todo("ollama-nv.ollapi.chat_stream")

// A stream's state and the chunks one read produced.
pub struct OllStreamStep
    state: OllStreamState
    chunks: [OllChunk]

// Read more of a streamed reply.
//
// An EMPTY chunk list means the bytes read did not finish an object,
// not that the stream ended: `state.acc.finished` is the end
// condition, and `ollgen.finish` turns it into a reply.
//
// ```novo ignore
// use ollapi
//
// fn pump(t: LlmcStdHttp, s: OllStreamState) -> Result<OllStreamStep, OllFault> [io, net, time, async]
//     ollapi.stream_next(t, s)
// ```
pub fn stream_next<T: LlmcTransport[e]>(t: T,
                                        s: OllStreamState) -> Result<OllStreamStep, OllFault> [e]
    todo("ollama-nv.ollapi.stream_next")

// One `/api/embed` or `/api/embeddings`.
