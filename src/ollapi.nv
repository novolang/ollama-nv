pub fn copy<T: LlmcTransport[e]>(t: T, source: Str, destination: Str) -> Result<Unit, OllFault> [e]
    todo("ollama-nv.ollapi.copy")

// Open a `/api/pull` and answer the state to pump.
//
// **NOT A CALL THAT RETURNS WHEN THE DOWNLOAD FINISHES.**  A 40 GB
// pull is twenty minutes, so the shape is open-and-pump: this answers
// immediately, `pull_next` reads more, and `ollpull.overall` is what a
// caller draws.  A blocking `pull` does not exist in this package, and
// the README says why.
//
// ```novo ignore
// use ollapi
//
// fn start(t: LlmcStdHttp, model: Str) -> Result<OllPullStream, OllFault> [io, net, time, async]
//     ollapi.pull_open(t, model, false)
// ```
pub fn pull_open<T: LlmcTransport[e]>(t: T, model: Str,
                                      insecure: Bool) -> Result<OllPullStream, OllFault> [e]
    todo("ollama-nv.ollapi.pull_open")

// A pull in progress: the line reader and the accumulated state.
pub struct OllPullStream
    reader: OllNdReader
    state: OllPullState
    read_bytes: Int

// A pull's state and the events one read produced.
pub struct OllPullStep
    stream: OllPullStream
    events: [OllPullEvent]

// Read more of a pull.
//
// The events are answered as well as folded, so a caller can log each
// one and draw from the folded state without walking the list twice.
//
// ```novo ignore
// use ollapi
//
// fn pump(t: LlmcStdHttp, s: OllPullStream) -> Result<OllPullStep, OllFault> [io, net, time, async]
//     ollapi.pull_next(t, s)
// ```
pub fn pull_next<T: LlmcTransport[e]>(t: T, s: OllPullStream) -> Result<OllPullStep, OllFault> [e]
    todo("ollama-nv.ollapi.pull_next")

// Open a `/api/push`, with the same pump.
//
// ```novo ignore
// use ollapi
//
// fn start(t: LlmcStdHttp, model: Str) -> Result<OllPullStream, OllFault> [io, net, time, async]
//     ollapi.push_open(t, model, false)
// ```
pub fn push_open<T: LlmcTransport[e]>(t: T, model: Str,
                                      insecure: Bool) -> Result<OllPullStream, OllFault> [e]
    todo("ollama-nv.ollapi.push_open")

// Open a `/api/create`, with the same pump.
//
// ```novo ignore
// use ollapi
//
// fn start(t: LlmcStdHttp, name: Str, m: OllModelfile) -> Result<OllPullStream, OllFault> [io, net, time, async]
//     ollapi.create_open(t, name, m)
// ```
pub fn create_open<T: LlmcTransport[e]>(t: T, name: Str,
                                        m: OllModelfile) -> Result<OllPullStream, OllFault> [e]
    todo("ollama-nv.ollapi.create_open")

// Load a model into memory without generating anything.
//
// An empty prompt with a residency, which is this server's own
// convention and answers `OllDoneLoad`.  Published because a service
// that wants its first real request to be fast has to do exactly this
// and would otherwise send a throwaway prompt and pay for its tokens.
//
// ```novo ignore
// use ollapi
//
// fn warm(t: LlmcStdHttp, model: Str) -> Result<OllReply, OllFault> [io, net, time, async]
//     ollapi.preload(t, model, OllKeepForever)
// ```
pub fn preload<T: LlmcTransport[e]>(t: T, model: Str,
                                    k: OllKeepAlive) -> Result<OllReply, OllFault> [e]
    todo("ollama-nv.ollapi.preload")

// Unload a model from memory now.
//
// `OllKeepNone` on an empty prompt.  The other half of `preload`, and
// what a program that has finished with a large model owes a machine
// somebody else is also using.
//
// ```novo ignore
// use ollapi
//
// fn evict(t: LlmcStdHttp, model: Str) -> Result<OllReply, OllFault> [io, net, time, async]
//     ollapi.unload(t, model)
// ```
pub fn unload<T: LlmcTransport[e]>(t: T, model: Str) -> Result<OllReply, OllFault> [e]
    todo("ollama-nv.ollapi.unload")

// The path an endpoint is reached at.
//
// `[]`, and published, so a caller driving its own transport never
// writes a path — and so a test asserts the paths without a server.
//
// ```novo
// use ollapi
//
// fn main() [io]
//     println(ollapi.path_of(OllEndpointChat))
//     // : /api/chat
// ```
pub fn path_of(e: OllEndpoint) -> Str []
    todo("ollama-nv.ollapi.path_of")

// One endpoint of this API.
pub enum OllEndpoint
    OllEndpointGenerate
    OllEndpointChat
    OllEndpointEmbed
    OllEndpointEmbeddings
    OllEndpointTags
    OllEndpointShow
    OllEndpointPs
    OllEndpointVersion
    OllEndpointPull
    OllEndpointPush
    OllEndpointCreate
    OllEndpointDelete
    OllEndpointCopy

// Whether an endpoint streams newline-delimited objects.
//
// The question that decides which reader to drive, answered from the
// endpoint rather than from a `Content-Type` the server sets to
// `application/x-ndjson` on some versions and `application/json` on
// others.
//
// ```novo
// use ollapi
//
// fn main() [io]
//     println("${ollapi.streams(OllEndpointPull)}")
//     // : true
// ```
pub fn streams(e: OllEndpoint) -> Bool []
    todo("ollama-nv.ollapi.streams")

// Whether a reply's status and body mean the server is simply not
// running.
//
// The most common failure a program using this package will see, and
// the one that is not a network problem: `ollama serve` is not up.
//
// ```novo
// use ollapi
//
// fn main() [io]
//     println("${ollapi.is_not_running(ollapi.local_provider(), "connection refused")}")
//     // : true
// ```
pub fn is_not_running(p: LlmcProvider, transport_message: Str) -> Bool []
    todo("ollama-nv.ollapi.is_not_running")
