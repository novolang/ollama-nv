// `/api/ps` — what is loaded right now, and how much of it is on the
// GPU.
//
// The management call with no counterpart in any hosted API, because
// no hosted API has a machine the caller is responsible for.
//
// ```novo ignore
// use ollapi
//
// fn loaded(t: LlmcStdHttp) -> Result<[OllResident], OllFault> [io, net, time, async]
//     ollapi.ps(t)
// ```
pub fn ps<T: LlmcTransport[e]>(t: T) -> Result<[OllResident], OllFault> [e]
    todo("ollama-nv.ollapi.ps")

// `/api/version` — the server's version string.
//
// Worth having because this API's shapes have changed between
// versions — `/api/embed` did not always exist — and a client that
// asked once can say so rather than failing obscurely.
//
// ```novo ignore
// use ollapi
//
// fn v(t: LlmcStdHttp) -> Result<Str, OllFault> [io, net, time, async]
//     ollapi.version(t)
// ```
pub fn version<T: LlmcTransport[e]>(t: T) -> Result<Str, OllFault> [e]
    todo("ollama-nv.ollapi.version")

